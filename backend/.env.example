# 数据库
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/decimeet
DATABASE_ECHO=false

# LLM（通义千问，兼容 OpenAI 接口）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# 音频转写：本地演示默认 mock；真实链路改为 dashscope 并配置下方 OSS/DashScope
TRANSCRIPTION_PROVIDER=mock
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=paraformer-v2
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=
OSS_PREFIX=audio/

# 服务端口
SERVER_PORT=8787

# 文件存储
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGINS=["http://localhost:5173"]
